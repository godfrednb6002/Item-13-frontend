PORT=3001
HOST=127.0.0.1
NODE_ENV=development
MOMO_DEMO_MODE=true
TRUST_PROXY=false

# Required when MOMO_DEMO_MODE=false. Create credentials in MTN's developer portal.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# sandbox for tests; production uses MTN Ghana's production target environment.
MOMO_TARGET_ENVIRONMENT=sandbox
# Optional public HTTPS webhook URL, e.g. https://shop.example.com/api/webhooks/mtn
MOMO_CALLBACK_URL=
# Optional SQLite file path; defaults to server/data/payments.sqlite3
MOMO_DATABASE_PATH=
